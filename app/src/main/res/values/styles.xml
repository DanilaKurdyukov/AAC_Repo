<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BigTextStyle">
        <item name="android:textSize">@dimen/big_text_size</item>
    </style>

    <style name="SmallTextStyle">
        <item name="android:textSize">@dimen/small_text_size</item>
    </style>

    <style name="TextInputLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_layout_outline</item>
        <item name="hintTextColor">@color/text_input_layout_hint</item>
        <item name="android:layout_margin">@dimen/small_dimen</item>
        <!--<item name="android:textColorHint">@color/grey_900</item>-->
        <item name="hintTextAppearance">@style/BigTextStyle</item>
        <item name="boxStrokeWidth">@dimen/box_stroke_width</item>
        <item name="errorTextAppearance">@style/SmallTextStyle</item>
        <item name="counterTextAppearance">@style/SmallTextStyle</item>
    </style>

    <style name="EditTextStyle" parent="Theme.AppCompat.Light">
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/grey_900</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ButtonStyle">
        <item name="android:backgroundTint">@color/green_200</item>
        <item name="android:layout_margin">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/big_text_size</item>
        <item name="android:textColor">@color/grey_900</item>
    </style>

    <style name="TextViewStyle">
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">@dimen/small_text_size</item>
        <item name="android:textColor">@color/grey_900</item>
        <!--<item name="android:textAlignment">center</item>-->
        <item name="android:textStyle">bold</item>
    </style>

</resources>